{
  "name": "amda-collection-backend",
  "version": "1.0.0",
  "description": "AMDA Mini Grid Collection Tool Backend API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts --watch src --ext ts,js,json",
    "start:debug": "nodemon --exec ts-node -r tsconfig-paths/register --inspect src/main.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./tests/e2e/jest.config.js",
    "migration:generate": "bash -c 'typeorm-ts-node-commonjs migration:generate src/database/migrations/${1:-Migration} -d src/database/connection.ts' --",
    "migration:run": "typeorm-ts-node-commonjs migration:run",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert",
    "seed": "ts-node scripts/seed-db.ts",
    "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up --build",
    "docker:dev:down": "docker-compose -f docker/docker-compose.dev.yml down",
    "docker:dev:restart": "docker-compose -f docker/docker-compose.dev.yml restart",
    "docker:dev:logs": "docker-compose -f docker/docker-compose.dev.yml logs -f",
    "docker:prod": "docker compose -f docker/docker-compose.yml up --build -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.yml down",
    "docker:clean": "docker compose -f docker/docker-compose.dev.yml down -v",
    "docker:build": "docker build -t amda-collection-api .",
    "swagger:generate": "ts-node scripts/generate-swagger.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register scripts/seed-admin.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "ci": "npm run format:check && npm run lint:check && npm run build && npm test",
    "ci:local": "npm run format && npm run lint && npm run build && npm test",
    "lint": "eslint src/**/*.{ts,js} --fix",
    "lint:check": "eslint src/**/*.{ts,js}",
    "precommit": "npm run format && npm run lint && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "fs": "^0.0.1-security",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "path": "^0.12.7",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.17",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.11",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "typeorm",
    "mini-grid",
    "collection-tool",
    "amda"
  ],
  "author": "AMDA Development Team",
  "license": "MIT"
}
